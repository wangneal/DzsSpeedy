<?xml version="1.0" encoding="UTF-8"?>
<!--
  DzsSpeedy root-certificate handling for the MSI installer.

  The speedpatch DLLs are signed by a self-built root CA (see
  _tools/codesign/sign-speedpatch.ps1). TerSafe validates the Authenticode
  trust chain of hook-injected DLLs, so the machine running DzsSpeedy must
  trust that root. This fragment:

    - installs the bundled dzsspeedy-root.cer (shipped via
      bundle.resources -> INSTALLFOLDER, see tauri.conf.json) into the
      machine TRUSTED ROOT store during install (deferred, non-impersonated
      = SYSTEM, so no extra UAC)
    - removes the root (by CN) when the product is uninstalled

  The .cer must match the root that signed the shipped speedpatch DLLs.
  No File/Component elements live here on purpose: relative Source paths
  break light.exe (it runs from target/release/wix/<arch>), so the cert is
  a normal resource file instead.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <!-- Empty group referenced via componentGroupRefs (tauri.conf.json):
         WiX light only links fragment sections that are reachable from the
         product, so without a referenced symbol the CustomActions and the
         InstallExecuteSequence rows below would be dropped entirely. -->
    <ComponentGroup Id="DzsRootCert" />

    <!-- add: certutil -addstore Root "[INSTALLDIR]dzsspeedy-root.cer" -->
    <CustomAction Id="DzsAddRootCert" Directory="INSTALLDIR"
      ExeCommand="&quot;[SystemFolder]certutil.exe&quot; -addstore -f Root &quot;[INSTALLDIR]dzsspeedy-root.cer&quot;"
      Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- remove (by CN, fingerprint-agnostic): certutil -delstore Root "DzsSpeedy Root CA" -->
    <CustomAction Id="DzsDelRootCert" Directory="INSTALLDIR"
      ExeCommand="&quot;[SystemFolder]certutil.exe&quot; -delstore Root &quot;DzsSpeedy Root CA&quot;"
      Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <!-- ICE77: in-script (deferred) custom actions must run between
           InstallInitialize and InstallFinalize. After=InstallFiles means
           the cert file is already on disk (install) while nothing needs
           the file for removal (-delstore works by CN). -->
      <Custom Action="DzsAddRootCert" After="InstallFiles">NOT Installed AND NOT REMOVE</Custom>
      <Custom Action="DzsDelRootCert" After="InstallFiles">REMOVE~="ALL"</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
